// Configuración para publicar en Cloudflare como Worker de sólo archivos
// estáticos (la modalidad que ofrece hoy el panel de Cloudflare).
//
// En el panel: Build command  node scripts/construir.mjs
//              Deploy command npx wrangler deploy
//              Build variable MASCOTAAPP_API_KEY (secreta)
//
// "name" tiene que coincidir con el nombre del proyecto en el panel.
{
  "name": "patitasunidaslanding",
  "compatibility_date": "2026-10-01",
  // "npx wrangler deploy" corre esto antes de publicar: así se construye
  // aunque el campo "Build command" del panel quede vacío (y si se llena con
  // lo mismo, sólo se construye dos veces, sin romper nada)
  "build": {
    "command": "node scripts/construir.mjs"
  },
  "assets": {
    // lo arma scripts/construir.mjs: el sitio sin scripts/ ni archivos
    // internos, con los datos frescos de MascotaApp
    "directory": "./dist",
    // como hacía GitHub Pages: una dirección que no existe muestra 404.html
    "not_found_handling": "404-page"
  }
}
